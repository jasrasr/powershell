{
  "apps": [
    { "name": "PowerShell 7", "id": "Microsoft.PowerShell", "enabled": true, "upgrade": true },
    { "name": "PowerShell 7 Preview", "id": "Microsoft.PowerShell.Preview", "enabled": true, "upgrade": true },
    { "name": "Windows Terminal", "id": "Microsoft.WindowsTerminal", "enabled": true },
    { "name": "Git", "id": "Git.Git", "enabled": true },
    { "name": "GitHub CLI", "id": "GitHub.cli", "enabled": true },
    { "name": "Visual Studio Code", "id": "Microsoft.VisualStudioCode", "enabled": true },
    { "name": "7-Zip", "id": "7zip.7zip", "enabled": true },
    { "name": "Google Chrome", "id": "Google.Chrome", "enabled": true },
    { "name": "Microsoft PowerToys", "id": "Microsoft.PowerToys", "enabled": true },
    { "name": "Everything", "id": "voidtools.Everything", "enabled": true },
    { "name": "Greenshot", "id": "Greenshot.Greenshot", "enabled": true },
    { "name": "Node.js LTS (includes npm)", "id": "OpenJS.NodeJS.LTS", "enabled": true },
    { "name": "PHP 8.5", "id": "PHP.PHP.8.5", "enabled": true },
    { "name": "Chocolatey", "id": "Chocolatey.Chocolatey", "enabled": true }
  ],
  "directInstallers": [
    {
      "name": "3D Clipboard",
      "version": "1.5.1",
      "url": "https://www.3dclipboard.com/release/3dclip-1.5.1.exe",
      "sha256": "7E6256892A412D16242D84811FB84992D14C22EEC2CF7BF3F5A4501428268843",
      "arguments": "/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-",
      "displayNamePattern": "3D Clipboard*",
      "enabled": true
    }
  ],
  "npmPackages": [
    { "name": "Codex CLI", "id": "@openai/codex", "enabled": true },
    { "name": "Claude Code", "id": "@anthropic-ai/claude-code", "enabled": true }
  ],
  "vscodeExtensions": [
    { "id": "ms-vscode.powershell", "enabled": true }
  ],
  "appSettings": [
    { "name": "Greenshot", "source": "config/Greenshot.ini", "destination": "%APPDATA%\\Greenshot\\Greenshot.ini", "backup": true, "stopProcess": "Greenshot", "expandPathTokens": true, "enabled": true },
    { "name": "Everything", "source": "config/Everything.ini", "destination": "%APPDATA%\\Everything\\Everything.ini", "backup": true, "stopProcess": "Everything", "enabled": true },
    { "name": "Windows Terminal", "source": "config/terminal-settings.json", "destination": "%LOCALAPPDATA%\\Packages\\Microsoft.WindowsTerminal_8wekyb3d8bbwe\\LocalState\\settings.json", "backup": true, "enabled": true },
    { "name": "3D Clipboard", "source": "config/3dclipboard.reg", "registryImport": true, "stopProcess": "clip", "enabled": true },
    { "name": "PowerToys", "source": "config/powertoys-settings.zip", "destination": "%LOCALAPPDATA%\\Microsoft\\PowerToys", "extract": true, "expandPathTokens": true, "stopProcess": ["PowerToys", "PowerToys.Settings"], "enabled": true },
    { "name": "Visual Studio Code settings", "source": "config/vscode/settings.json", "destination": "%APPDATA%\\Code\\User\\settings.json", "backup": true, "enabled": false },
    { "name": "Visual Studio Code keybindings", "source": "config/vscode/keybindings.json", "destination": "%APPDATA%\\Code\\User\\keybindings.json", "backup": true, "enabled": false }
  ],
  "powershellModules": [
    { "name": "ExchangeOnlineManagement", "enabled": true, "import": "ExchangeOnlineManagement", "connect": "Connect-ExchangeOnline", "connectArguments": { "ShowBanner": false } },
    { "name": "Microsoft.Graph", "enabled": true, "import": "Microsoft.Graph.Authentication", "connect": "Connect-MgGraph", "connectArguments": { "NoWelcome": true } },
    { "name": "MicrosoftTeams", "enabled": true, "import": "MicrosoftTeams", "connect": "Connect-MicrosoftTeams" }
  ],
  "windowsCapabilities": [
    { "name": "Active Directory RSAT tools", "id": "Rsat.ActiveDirectory.DS-LDS.Tools~~~~0.0.1.0", "enabled": true }
  ],
  "requireOneDrive": true,
  "finalPass": { "enabled": true },
  "profile": { "enabled": true },
  "registrySettings": [
    {
      "description": "Show file extensions",
      "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "name": "HideFileExt",
      "value": 0,
      "type": "DWord",
      "enabled": true
    },
    {
      "description": "Show hidden files",
      "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "name": "Hidden",
      "value": 1,
      "type": "DWord",
      "enabled": true
    }
  ],
  "postInstallNotes": [
    "Mouse Without Borders is enabled in PowerToys but its security key is intentionally not stored in this repo. Open PowerToys > Mouse Without Borders and enter (or generate and share) the key from your password manager."
  ],
  "restartExplorer": true
}
